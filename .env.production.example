# AWS Production Environment Variables
NODE_ENV=production
PORT=8080

# Frontend URL (your deployed frontend)
FRONTEND_URL=https://inblox.in

# Google OAuth (update with your production credentials)
GOOGLE_CLIENT_ID=your_production_google_client_id
GOOGLE_CLIENT_SECRET=your_production_google_client_secret
GOOGLE_CALLBACK_URL=https://backend.inblox.in/api/auth/google/callback

# JWT Secret (generate a secure random string)
JWT_SECRET=your_secure_jwt_secret_min_32_characters_long

# MongoDB (use MongoDB Atlas or AWS DocumentDB)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/inblox

# Optional: Arduino CLI paths (if not using defaults)
# ARDUINO_CLI_PATH=/opt/arduino-cli/arduino-cli
# ARDUINO_CONFIG_FILE=/opt/.arduino15/arduino-cli.yaml
