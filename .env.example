# Server Configuration
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=mongodb://localhost:27017/inblox

# JWT Secret
JWT_SECRET=your_jwt_secret_key_here

# Frontend URL
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:3001

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Email Configuration (Resend)
# Sign up at https://resend.com to get your API key
RESEND_API_KEY=abcd1234efgh5678ijkl9012mnop3456qrst
# Email address to send from (must be verified in Resend)
# For testing, you can use: onboarding@resend.dev
EMAIL_FROM=onboarding@resend.dev

# Application Name (used in emails)
APP_NAME=Inblox
